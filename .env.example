NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pawcare
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA_FILE=
# npm run setup creates these cryptographically random values.
MFA_ENCRYPTION_KEY=
TOKEN_HASH_KEY=
# Development mail is written to .mail/ for local use. Production requires SMTP.
MAIL_MODE=file
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PawCare <noreply@example.com>
UPLOAD_DIR=uploads
